{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./",
    "paths": {
      "@": ["*"],
      "@components": ["components/index.ts"],
      "@common": ["common/index.ts"],
      "@providers": ["providers/index.ts"],
      "@types": ["types/index.d.ts"],
      "@store": ["store/index.ts"],
      "@store/user": ["store/user/index.ts"],
      "@assets": ["assets/index.ts"],
      "@layouts": ["layouts/index.ts"],
      "@constants": ["constants/index.ts"],
      "@hooks": ["hooks/index.ts"],
      "@services": ["services/index.ts"],
      "@store-types": ["store/types.d.ts"],
      "@slice": ["store/slice.ts"],
      "@actions": ["app/actions.ts"],
      "@selectors": ["selectors/index.ts"],
      "@init-globals": ["utils/globals.ts"],
      "@service": ["service/index.ts"],
      "@fetch": ["fetch/index.ts"],
      "@types-services": ["service/types.d.ts"],
      "@clienthooks": ["clienthooks/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
